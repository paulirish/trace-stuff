{
  "compilerOptions": {
    "outDir": ".tmp/tsbuildinfo/",
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,

    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,

    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,


    // typescript node .  https://nodesource.com/blog/Node.js-Supports-TypeScript-Natively
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,


    "lib": ["ESNext", "dom"]

    // "listFiles": true,
    // "noErrorTruncation": true,
    // "extendedDiagnostics": true,

    // TODO(esmodules): included to support require('file.json'). Remove on the switch to ES Modules.
    //   "resolveJsonModule": true,
  },
  "include": [
    "types/*.d.ts",
    "*.js",
    "*.mjs",
    "*.mts",
    "*.ts",
    // not third_party yet


    "@paulirish/trace_engine/generated/protocol.d.ts",

    // TODO(esmodules): JSON files included via resolveJsonModule. Removable on the switch to ES Modules.
    "package.json"
  ]
}
